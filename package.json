{
  "name": "gear-lands",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Gear Lands — an atmospheric steampunk metroidvania for the browser.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/export-standalone.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "preview:pages": "node scripts/serve-pages.mjs",
    "test": "node --test tests/*.test.js",
    "audio": "python scripts/synthesize_audio.py",
    "test:e2e": "npm run build && playwright test && playwright test --config playwright.release.config.js",
    "test:release": "playwright test --config playwright.release.config.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "vite": "^8.3.6"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "lucide": "^1.70.0"
  }
}
